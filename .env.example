# TrendPreneur Expo Client Environment Variables
# Copy this file to .env or .env.local to customize your configuration

# Set to "true" to run with mock data and zero backend dependency (default)
EXPO_PUBLIC_USE_MOCK=true

# API URL for live backend mode (used when EXPO_PUBLIC_USE_MOCK=false)
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# Developer admin key for simulating payment verification approvals in dev mode
EXPO_PUBLIC_DEV_ADMIN_KEY=dev-admin-secret-key
